              <Static id="Static00_00" taborder="1" text="Gemini" left="41" top="27" width="68" height="36" font="normal 700 15pt/normal &quot;Arial&quot;" background="lightcoral" color="white"/>
              <Static id="Static00_00_00" taborder="8" text="TOBESOFT" left="399" top="27" width="109" height="36" font="normal 700 15pt/normal &quot;Arial&quot;" background="lightcoral" color="white"/>
