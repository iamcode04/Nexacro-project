    <Script type="xscript5.1"><![CDATA[this.fvApp = nexacro.getApplication();
this.fvAiReply = "";
this.fvLoginTarget = "";
this.fvLoungeUserId = "";
this.fvLoungeUserName = "";

this.form_onsize = function(obj:nexacro.Form,e:nexacro.SizeEventInfo)
{
	var nLeft = (this.fvApp.mainframe.width/2) - Math.round((this.divTop.form.getOffsetWidth()) / 2);
	
	if(nLeft <= 0) {
		this.divTop.setOffsetLeft(0);
		this.divMain.setOffsetLeft(0);
	}
	else {
		this.divTop.setOffsetLeft(nLeft);
		this.divMain.setOffsetLeft(nLeft);
	}
};

this.form_onload = function(obj:nexacro.Form,e:nexacro.LoadEventInfo)
{
	this.form_onsize();
	
	var objCF = new ChildFrame("popupLoginIntro", 0, 0, 320, 600);
	objCF.formurl = "User::User_Login.xfdl";
	objCF.openalign = "center middle";
		this.divMain.form.aiChatScreen.set_readonly(true);
	objCF.showModal(this.getOwnerFrame(), null, this, "fn_loginIntroPopupCallback");
	
};

this.fn_loginIntroPopupCallback = function(sPopupId, sReturn)
{
	if (sPopupId == "popupLoginIntro")
	{
		// 팝업 닫힌 후 필요하면 여기서 처리
	}
};

this.divTop_btnSignUp_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	var objCF = new ChildFrame("popupSignUp", 0, 0, 1000, 850);
	objCF.formurl = "User::User_SignUp.xfdl";
	objCF.openalign = "center middle";
	objCF.showModal(this.getOwnerFrame(), null, this, "fn_signUpPopupCallback");
};

this.fn_signUpPopupCallback = function(sPopupId, sReturn)
{
	if (sPopupId == "popupSignUp")
	{
		// 회원가입 팝업이 닫힌 후 필요하면 여기서 처리
	}
};

this.divMain_aiGo_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	var msg = this.divMain.form.aiTextArea.value;
	if (msg == "" || msg == null)
	{
		this.alert("메시지를 입력해주세요.");
		return;
	}

	this.transaction("svcAiChat"
	                 ,"SvcUrl::ai/chat.do"
	                 ,""
	                 ,""
	                 ,"message=" + nexacro.wrapQuote(msg)
	                 ,"fn_aiChatCallback");
};

this.fn_aiChatCallback = function(svcID, errCode, errMsg)
{
	if (errCode < 0)
	{
		this.alert("AI 응답 중 오류가 발생했습니다: " + errMsg);
		return;
	}
	this.divMain.form.aiChatScreen.set_value(this.fvAiReply);
};

this.divMain_ImageViewer00_onclick = function(obj:nexacro.ImageViewer,e:nexacro.ClickEventInfo)
{
	window.open("https://www.tobesoft.com/main", "_blank");
};

this.divTop_btnSignUp_onmouseenter = function(obj:nexacro.Button,e:nexacro.MouseEventInfo)
{
	obj.background = "darkblue";
};

this.divTop_btnSignUp_onmouseleave = function(obj:nexacro.Button,e:nexacro.MouseEventInfo)
{
	obj.background = "indianred";
};

this.divTop_btnSignUp00_onmouseenter = function(obj:nexacro.Button,e:nexacro.MouseEventInfo)
{
	obj.background = "blue";
};

this.divTop_btnSignUp00_onmouseleave = function(obj:nexacro.Button,e:nexacro.MouseEventInfo)
{
	obj.background = "#ff99aa";
};

this.divMain_Static03_onmouseenter = function(obj:nexacro.Static,e:nexacro.MouseEventInfo)
{
	obj.border = "2px solid blue";
};

this.divMain_Static03_onmouseleave = function(obj:nexacro.Static,e:nexacro.MouseEventInfo)
{
	obj.border = "2px solid lightcoral";
};

this.divMain_Static04_onmouseenter = function(obj:nexacro.Static,e:nexacro.MouseEventInfo)
{
	obj.border = "2px solid blue";
};

this.divMain_Static04_onmouseleave = function(obj:nexacro.Static,e:nexacro.MouseEventInfo)
{
	obj.border = "2px solid lightcoral";
};

this.divTop_ImageViewer00_00_00_onclick = function(obj:nexacro.ImageViewer,e:nexacro.ClickEventInfo)
{
	alert("ㅎㅎㅎㅎㅎㅎ");
};

this.divMain_staMove_onclick = function(obj:nexacro.Static,e:nexacro.ClickEventInfo)
{
	this.fvLoginTarget = "workpage";
	var objCF = new ChildFrame("popupLogin", 0, 0, 300, 300);
	objCF.formurl = "FrameBase::sdiOnLogin.xfdl";
	objCF.openalign = "center middle";
	objCF.showModal(this.getOwnerFrame(), null, this, "fn_loginPopupCallback");
};

this.fn_loginPopupCallback = function(sPopupId, sReturn)
{
	if (sPopupId == "popupLogin" && sReturn != null && sReturn.indexOf("OK|") == 0)
	{
		var arrRet = sReturn.split("|");
		var sUserId = arrRet[1];
		var sUserName = arrRet[2];
		var sSecName = arrRet[3];

		if (this.fvLoginTarget == "lounge")
		{
			if (sSecName == "" || sSecName == null)
			{
				this.fvLoungeUserId = sUserId;
				this.fvLoungeUserName = sUserName;

				var objNick = new ChildFrame("popupNick", 0, 0, 300, 300);
				objNick.formurl = "User::User_LoungeNick.xfdl";
				objNick.openalign = "center middle";
				objNick.param = {userId: sUserId};
				objNick.showModal(this.getOwnerFrame(), null, this, "fn_nickPopupCallback");
			}
			else
			{
				this.fn_openLounge(sUserId, sUserName, sSecName);
			}
		}
		else
		{
			var objWork = new ChildFrame("workPage", 0, 0, 1000, 850);
			objWork.formurl = "User::User_WorkPage.xfdl";
			objWork.openalign = "center middle";
			objWork.param = {userId: sUserId, userName: sUserName};
			objWork.showModal(this.getOwnerFrame(), null, this, "fn_workPageCallback");
		}
	}
};

this.fn_nickPopupCallback = function(sPopupId, sReturn)
{
	if (sPopupId == "popupNick" && sReturn != null && sReturn != "")
	{
		this.fn_openLounge(this.fvLoungeUserId, this.fvLoungeUserName, sReturn);
	}
};

this.fn_openLounge = function(sUserId, sUserName, sSecName)
{
	var objLounge = new ChildFrame("loungePage", 0, 0, 1000, 850);
	objLounge.formurl = "User::User_lounge.xfdl";
	objLounge.openalign = "center middle";
	objLounge.param = {userId: sUserId, userName: sUserName, secName: sSecName};
	objLounge.showModal(this.getOwnerFrame(), null, this, "fn_loungePageCallback");
};

this.fn_loungePageCallback = function(sPopupId, sReturn)
{
	// 라운지 닫힐 때 처리할 게 있으면 여기에
};

this.fn_workPageCallback = function(sPopupId, sReturn)
{
	// 업무 화면이 닫힐 때 처리할 게 있으면 여기에
};

this.divMain_Static01_00_01_onmouseenter = function(obj:nexacro.Static,e:nexacro.MouseEventInfo)
{
	obj.color= "blue";
};

this.divMain_Static01_00_01_onmouseleave = function(obj:nexacro.Static,e:nexacro.MouseEventInfo)
{
	obj.color = "gray";
};

this.divMain_Static01_00_01_00_onmouseenter = function(obj:nexacro.Static,e:nexacro.MouseEventInfo)
{
	obj.color = "blue";
};

this.divMain_Static01_00_01_00_onmouseleave = function(obj:nexacro.Static,e:nexacro.MouseEventInfo)
{
	obj.color ="gray";
};

this.divMain_staMove_onmouseenter = function(obj:nexacro.Static,e:nexacro.MouseEventInfo)
{
	obj.border = "2px solid blue";
};

this.divMain_staMove_onmouseleave = function(obj:nexacro.Static,e:nexacro.MouseEventInfo)
{
	obj.border = "2px solid lightcoral";
};

this.divMain_staLounge_onclick = function(obj:nexacro.Static,e:nexacro.ClickEventInfo)
{
	this.fvLoginTarget = "lounge";
	var objCF = new ChildFrame("popupLogin", 0, 0, 300, 300);
	objCF.formurl = "FrameBase::sdiOnLogin.xfdl";
	objCF.openalign = "center middle";
	objCF.showModal(this.getOwnerFrame(), null, this, "fn_loginPopupCallback");
};
this.divMain_staLounge_onmouseenter = function(obj:nexacro.Static,e:nexacro.MouseEventInfo)
{
	obj.border = "2px solid blue";
};

this.divMain_staLounge_onmouseleave = function(obj:nexacro.Static,e:nexacro.MouseEventInfo)
{
	obj.border = "2px solid lightcoral";
};
this.divMain_aiGo_onmouseenter = function(obj:nexacro.Button,e:nexacro.MouseEventInfo)
{
	obj.set_background("red");
};

this.divMain_aiGo_onmouseleave = function(obj:nexacro.Button,e:nexacro.MouseEventInfo)
{
	obj.set_background("lightcoral");
};
]]></Script>
  </Form>
