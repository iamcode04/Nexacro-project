<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="User_LoungeNick" width="300" height="300" titletext="New Form">
    <Layouts>
      <Layout height="300" width="300">
        <ImageViewer id="ImageViewer00" taborder="0" left="0" top="0" width="300" height="300" border="0px solid black" image="url('imagerc::peppepep.png')" stretch="fit"/>
        <Static id="idBox" taborder="1" text="익명" left="10" top="220" width="98" height="30" borderRadius="15px 0px 0px 15px" border="0px solid white" textAlign="center" background="green" color="white" font="normal 700 10pt/normal &quot;Arial&quot;"/>
        <Edit id="nickEdit" taborder="2" left="108" top="220" width="182" height="30" borderRadius="0px 15px 15px 0px" background="whitesmoke" text=""/>
        <Static id="Static00" taborder="3" left="10" top="17" width="280" height="163" background="snow" borderRadius="20px 20px 20px 20px " border="3px solid black"/>
        <Static id="Static01" taborder="4" text="투비 라운지" left="40" top="35" width="71" height="15" font="normal bold 10pt/normal &quot;Arial&quot;" color="red"/>
        <Static id="Static01_00" taborder="5" text="RULE &gt;" left="115" top="35" width="57" height="15" font="normal bold 10pt/normal &quot;Arial&quot;" color="black"/>
        <Static id="Static01_00_01" taborder="7" left="25" top="52" width="247" height="15" font="normal 700 7pt/normal &quot;Arial&quot;" color="black" text="1. 타인을 비방하거나 욕설·혐오 표현을 사용하지 않습니다."/>
        <Static id="Static01_00_01_00" taborder="8" left="25" top="67" width="247" height="15" font="normal 700 7pt/normal &quot;Arial&quot;" color="black" text="2. 특정인의 실명, 연락처 등 개인정보를 게시하지 않습니다."/>
        <Static id="Static01_00_01_00_00" taborder="9" left="25" top="82" width="247" height="15" font="normal 700 7pt/normal &quot;Arial&quot;" color="black" text="3. 광고, 홍보, 도배성 게시글은 삭제될 수 있습니다."/>
        <Static id="Static01_00_01_00_00_00" taborder="10" left="25" top="97" width="247" height="15" font="normal 700 7pt/normal &quot;Arial&quot;" color="black" text="4. 허위사실 유포, 명예훼손성 글은 작성하지 않습니다."/>
        <Static id="Static01_00_01_00_00_00_00" taborder="11" left="25" top="112" width="247" height="15" font="normal 700 7pt/normal &quot;Arial&quot;" color="black" text="5. 익명이라도 내가 쓴 글에 대한 책임은 본인에게 있습니다."/>
        <Static id="Static01_00_01_00_00_00_00_00" taborder="12" left="25" top="127" width="267" height="15" font="normal 700 7pt/normal &quot;Arial&quot;" color="black" text="6. 규칙 위반 게시글/댓글은 사전 통보 없이 삭제될 수 있습니다."/>
        <Static id="Static01_00_01_00_00_00_00_00_00" taborder="13" left="22" top="150" width="257" height="10" font="normal 700 7pt/normal &quot;Arial&quot;" color="blue" text="다양한 의견을 존중하고, 반대 의견도 예의를 갖춰 남겨주세요."/>
        <Static id="Static01_00_00" taborder="6" text="&lt;" left="29" top="34" width="8" height="15" font="normal bold 10pt/normal &quot;Arial&quot;" color="black"/>
        <CheckBox id="agreeCheck" taborder="14" text="규칙에 동의하며 준수하겠습니다." left="10" top="183" width="280" height="24" background="snow" border="3px solid black" color="red" borderRadius="20px 20px 20px 20px" textAlign="center"/>
        <Button id="saveNick" taborder="15" text="저장" left="100" top="258" width="100" height="30" color="white" background="green" font="normal bold 12pt/normal &quot;Arial&quot;" border="0px solid white" borderRadius="15px 15px 15px 15px" boxShadow="2px 2px 0px 0px black" onclick="saveNick_onclick" onmouseenter="saveNick_onmouseenter" onmouseleave="saveNick_onmouseleave"/>
      </Layout>
    </Layouts>
    <Objects>
      <Dataset id="ds_secName">
        <ColumnInfo>
          <Column id="USER_ID" type="STRING" size="256"/>
          <Column id="SEC_NAME" type="STRING" size="256"/>
        </ColumnInfo>
      </Dataset>
    </Objects>
    <Script type="xscript5.1"><![CDATA[
this.saveNick_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	if (!this.agreeCheck.isChecked())
	{
		this.alert("규칙에 동의해야 저장할 수 있습니다.");
		return;
	}

	var sNick = this.nickEdit.value;
	if (sNick == "" || sNick == null)
	{
		this.alert("닉네임을 입력해주세요.");
		return;
	}

	var objParam = this.getOwnerFrame().param;

	this.ds_secName.clearData();
	this.ds_secName.addRow();
	this.ds_secName.setColumn(0, "USER_ID", objParam.userId);
	this.ds_secName.setColumn(0, "SEC_NAME", sNick);

	this.transaction("svcUpdateSecName"
	                 ,"SvcUrl::user/updateSecName.do"
	                 ,"input=ds_secName"
	                 ,""
	                 ,""
	                 ,"fn_saveNickCallback");
};

this.fn_saveNickCallback = function(svcID, errCode, errMsg)
{
	if (errCode < 0)
	{
		this.alert("닉네임 저장 중 오류가 발생했습니다: " + errMsg);
		return;
	}
	this.close(this.nickEdit.value);
};

this.saveNick_onmouseenter = function(obj:nexacro.Button,e:nexacro.MouseEventInfo)
{
	obj.background = "darkgreen";
};

this.saveNick_onmouseleave = function(obj:nexacro.Button,e:nexacro.MouseEventInfo)
{
	obj.background = "green";
};
]]></Script>
  </Form>
</FDL>
